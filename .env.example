# Optional. Nothing here is needed to start the stack -- both containers default
# to root so that a fresh clone runs anywhere, including a Linux VPS.
#
# What it buys you: the files the containers create under data/, logs/ and
# mlflow-data/ belong to you instead of to root, so you can delete them without
# sudo. On a machine you share with anyone, that is worth the one command:
#
#     cp .env.example .env && sed -i "s/=1000$/=$(id -u)/" .env
#
# macOS and Windows can ignore this file: Docker Desktop maps ownership back to
# you regardless of the uid inside the container.

# Airflow writes data/staging/ and logs/. Its image also has a user 50000 of its
# own, which works only if that happens to be the uid owning those directories.
AIRFLOW_UID=1000

# MLflow writes mlflow-data/.
MLFLOW_UID=1000
